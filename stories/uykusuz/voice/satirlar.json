[
 {"id": "L01", "kim": "anlatici", "text": "Gece üçü kırk yedi geçiyor. Bütün şehir uyuyor."},
 {"id": "L02", "kim": "anlatici", "text": "Sen hariç."},
 {"id": "L03", "kim": "anlatici", "text": "Bu gece üç kitap bitirdin."},
 {"id": "L04", "kim": "anlatici", "text": "Gitarda yeni bir şarkı çıkardın."},
 {"id": "L05", "kim": "anlatici", "text": "Bir de Japonca öğrenmeye başladın."},
 {"id": "L06", "kim": "arkadas", "text": "Sen... hiç yatmadın mı?"},
 {"id": "L07", "kim": "sen", "text": "Yatmak mı?"},
 {"id": "L08", "kim": "anlatici", "text": "Seksen yıllık bir ömrün yaklaşık yirmi yedi yılı uykuda geçer."},
 {"id": "L09", "kim": "anlatici", "text": "Senin için?"},
 {"id": "L10", "kim": "anlatici", "text": "Sıfır."},
 {"id": "L11", "kim": "anlatici", "text": "Peki ya hiç uyuman gerekmeseydi?"},
 {"id": "L12", "kim": "anlatici", "text": "Bak, olay şöyle."}
]
